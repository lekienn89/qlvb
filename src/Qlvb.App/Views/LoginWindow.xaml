<Window x:Class="Qlvb.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý văn bản đi – đến" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Assets/qlvb.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Primary}" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/qlvb.png" Width="56" Height="56" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="QUẢN LÝ VĂN BẢN ĐI – ĐẾN" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Sổ đăng ký bí mật nhà nước – chạy ngoại tuyến trên một máy" Foreground="#D6E0F0" FontSize="12.5" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,20">
            <!-- Đăng nhập -->
            <StackPanel x:Name="PanelLogin" Visibility="Collapsed">
                <TextBlock Text="Mật khẩu" Style="{StaticResource Label}" />
                <PasswordBox x:Name="TxtPassword" KeyDown="TxtPassword_KeyDown" />
                <TextBlock x:Name="TxtCaps" Text="⚠ Đang bật Caps Lock" Foreground="{StaticResource Warn}" Visibility="Collapsed" Margin="0,4,0,0" />
                <TextBlock x:Name="TxtLoginError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="BtnLogin" Content="Đăng nhập" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnLogin_Click" DockPanel.Dock="Left" Margin="0,4,4,4" />
                    <Button Content="Thoát" Click="BtnExit_Click" DockPanel.Dock="Left" IsCancel="True" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"><Hyperlink Click="LnkForgot_Click">Quên mật khẩu?</Hyperlink></TextBlock>
                        <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0"><Hyperlink Click="LnkRestore_Click">Khôi phục từ bản sao lưu…</Hyperlink></TextBlock>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Thiết lập lần đầu -->
            <StackPanel x:Name="PanelSetup" Visibility="Collapsed">
                <TextBlock Text="Thiết lập lần đầu" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Hint}" Text="Phần mềm chưa có dữ liệu. Hãy đặt mật khẩu để mã hóa và bảo vệ dữ liệu. Không có mật khẩu mặc định." />
                <TextBlock Text="Tên cơ quan, tổ chức (in trên trang bìa sổ, có thể sửa sau)" Style="{StaticResource Label}" />
                <TextBox x:Name="TxtTenCoQuan" MaxLength="300" />
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource Label}" />
                <PasswordBox x:Name="TxtNewPw1" />
                <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource Label}" />
                <PasswordBox x:Name="TxtNewPw2" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Ít nhất 8 ký tự, gồm chữ cái và chữ số hoặc ký tự đặc biệt. Sau khi thiết lập, phần mềm cấp một MÃ KHÔI PHỤC; nếu quên cả mật khẩu và mã khôi phục thì KHÔNG THỂ mở lại dữ liệu." />
                <TextBlock x:Name="TxtSetupError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Thiết lập" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnSetup_Click" Margin="0,4,4,4" />
                    <Button Content="Thoát" Click="BtnExit_Click" IsCancel="True" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0"><Hyperlink Click="LnkRestore_Click">Đã có bản sao lưu? Khôi phục từ bản sao lưu…</Hyperlink></TextBlock>
            </StackPanel>

            <!-- Quên mật khẩu -->
            <StackPanel x:Name="PanelRecovery" Visibility="Collapsed">
                <TextBlock Text="Đặt lại mật khẩu bằng mã khôi phục" Style="{StaticResource H2}" />
                <TextBlock Text="Mã khôi phục (dạng XXXXX-XXXXX-XXXXX-XXXXX)" Style="{StaticResource Label}" />
                <TextBox x:Name="TxtRecoveryCode" CharacterCasing="Upper" FontFamily="Consolas" MaxLength="40" />
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource Label}" />
                <PasswordBox x:Name="TxtRecPw1" />
                <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource Label}" />
                <PasswordBox x:Name="TxtRecPw2" />
                <TextBlock x:Name="TxtRecError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Đặt lại mật khẩu" Style="{StaticResource PrimaryButton}" Click="BtnReset_Click" Margin="0,4,4,4" />
                    <Button Content="Quay lại" Click="BtnBack_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Thiếu tệp -->
            <StackPanel x:Name="PanelMissing" Visibility="Collapsed">
                <TextBlock Text="Không mở được dữ liệu" Style="{StaticResource H2}" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="TxtMissing" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Khôi phục từ bản sao lưu…" Style="{StaticResource PrimaryButton}" Click="LnkRestore_Click" Margin="0,4,4,4" />
                    <Button Content="Thoát" Click="BtnExit_Click" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
