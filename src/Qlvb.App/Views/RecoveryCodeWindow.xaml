<Window x:Class="Qlvb.App.Views.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mã khôi phục" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Ghi lại mã khôi phục" Style="{StaticResource H1}" />
        <TextBlock TextWrapping="Wrap"
                   Text="Mã này dùng để đặt lại mật khẩu khi quên. Hãy chép tay ra giấy và cất giữ như tài liệu mật (không chụp ảnh, không lưu trên máy tính có kết nối mạng)." />
        <Border Background="{StaticResource PrimaryLight}" Padding="16" Margin="0,16" CornerRadius="4">
            <TextBox x:Name="TxtCode" IsReadOnly="True" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                     HorizontalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
        </Border>
        <Border Style="{StaticResource WarnBox}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                       Text="Nếu mất cả mật khẩu và mã khôi phục thì KHÔNG AI có thể mở lại dữ liệu, kể cả người viết phần mềm. Mã chỉ hiển thị một lần." />
        </Border>
        <TextBlock Text="Nhập lại 5 ký tự cuối của mã để xác nhận đã ghi:" Style="{StaticResource Label}" Margin="0,12,0,2" />
        <TextBox x:Name="TxtConfirm" CharacterCasing="Upper" FontFamily="Consolas" MaxLength="5" Width="120" HorizontalAlignment="Left"
                 TextChanged="TxtConfirm_TextChanged" />
        <Button x:Name="BtnOk" Content="Tôi đã ghi lại mã" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                IsEnabled="False" Click="BtnOk_Click" Margin="0,16,0,0" />
    </StackPanel>
</Window>
