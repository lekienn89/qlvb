<Window x:Class="Qlvb.App.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đã khóa – Quản lý văn bản đi – đến" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Primary}" ShowInTaskbar="True" Topmost="True" Icon="/Assets/qlvb.ico">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="32" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/qlvb.png" Width="48" Height="48" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Phần mềm đã khóa" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="Nhập mật khẩu để tiếp tục làm việc." Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <PasswordBox x:Name="TxtPassword" Margin="0,20,0,0" />
                <TextBlock x:Name="TxtError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Mở khóa" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnUnlock_Click" />
                    <Button Content="Đăng xuất" Click="BtnLogout_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
