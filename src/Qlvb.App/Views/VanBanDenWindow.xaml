<Window x:Class="Qlvb.App.Views.VanBanDenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Văn bản đến" Width="900" Height="700" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" />
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="CmdSave" />
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CmdClose" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryLight}" Padding="20,10">
            <DockPanel>
                <Button x:Name="BtnCopyPrev" DockPanel.Dock="Right" Content="Sao chép từ văn bản trước" Click="BtnCopyPrev_Click" Margin="0" />
                <StackPanel>
                    <TextBlock x:Name="TxtHeader" Text="Đăng ký văn bản đến" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Primary}" />
                    <TextBlock x:Name="TxtSubHeader" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}" Text="Ctrl+S: Lưu   •   Esc: Đóng   •   (*) bắt buộc" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSaveNew" Content="Lưu và nhập tiếp" Click="BtnSaveNew_Click" />
                    <Button x:Name="BtnSave" Content="Lưu (Ctrl+S)" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" />
                    <Button Content="Đóng" Click="BtnClose_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,12">
                <Border x:Name="CopyBanner" Style="{StaticResource WarnBox}" Visibility="Collapsed">
                    <TextBlock x:Name="TxtCopyBanner" TextWrapping="Wrap" Foreground="{StaticResource Warn}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="(1) Số thứ tự" Style="{StaticResource Label}" />
                    <TextBox x:Name="TxtSoThuTu" Grid.Column="1" IsReadOnly="True" Background="#F1F3F6" FontWeight="SemiBold" />
                    <TextBlock Text="(2) Ngày đến (*)" Grid.Column="3" Style="{StaticResource Label}" />
                    <DatePicker x:Name="DpNgayDen" Grid.Column="4" SelectedDateChanged="DpNgayDen_Changed" />

                    <TextBlock Text="(3) Số đến (*)" Grid.Row="1" Style="{StaticResource Label}" />
                    <TextBox x:Name="TxtSoDen" Grid.Row="1" Grid.Column="1" MaxLength="7" PreviewTextInput="Digits_PreviewTextInput" />
                    <TextBlock Text="(8) Độ mật (*)" Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" />
                    <ComboBox x:Name="CbDoMat" Grid.Row="1" Grid.Column="4" DisplayMemberPath="HienThi" SelectionChanged="CbDoMat_SelectionChanged" />

                    <TextBlock Text="(4) Cơ quan ban hành (*)" Grid.Row="2" Style="{StaticResource Label}" />
                    <ComboBox x:Name="CbCoQuan" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" IsEditable="True" IsTextSearchEnabled="True" />

                    <TextBlock Text="(5) Số, ký hiệu (*)" Grid.Row="3" Style="{StaticResource Label}" />
                    <TextBox x:Name="TxtSoKyHieu" Grid.Row="3" Grid.Column="1" MaxLength="100" />
                    <TextBlock Text="(6) Ngày văn bản (*)" Grid.Row="3" Grid.Column="3" Style="{StaticResource Label}" />
                    <DatePicker x:Name="DpNgayVanBan" Grid.Row="3" Grid.Column="4" />

                    <TextBlock Text="Tên loại (*)" Grid.Row="4" Style="{StaticResource Label}" />
                    <DockPanel Grid.Row="4" Grid.Column="1">
                        <Button Content="+" ToolTip="Thêm nhanh loại văn bản" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="QuickAddLoai_Click" />
                        <ComboBox x:Name="CbTenLoai" IsEditable="True" IsTextSearchEnabled="True" />
                    </DockPanel>
                    <TextBlock Text="(9) Đơn vị nhận (*)" Grid.Row="4" Grid.Column="3" Style="{StaticResource Label}" />
                    <ComboBox x:Name="CbDonViNhan" Grid.Row="4" Grid.Column="4" IsEditable="True" IsTextSearchEnabled="True" />
                </Grid>

                <TextBlock Text="(7) Trích yếu nội dung (*)" Style="{StaticResource Label}" Margin="0,10,0,2" />
                <Grid>
                    <TextBox x:Name="TxtTrichYeu" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="2000"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <Border x:Name="TmNotice" Background="{StaticResource ErrorBg}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="10" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Accent}"
                                   Text="Tài liệu độ mật TUYỆT MẬT: KHÔNG ghi trích yếu (Điều 6 Nghị định 63/2026/NĐ-CP). Ô này bị khóa; cột (7) trên sổ chỉ ghi tên loại." />
                    </Border>
                </Grid>

                <TextBlock Text="(9) Ký nhận" Style="{StaticResource H2}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ChkDaKyNhan" Grid.ColumnSpan="2" Content="Đơn vị/người nhận đã ký nhận" />
                    <TextBlock Text="Người ký nhận" Grid.Row="1" Style="{StaticResource Label}" />
                    <TextBox x:Name="TxtNguoiKyNhan" Grid.Row="1" Grid.Column="1" MaxLength="300" />
                    <TextBlock Text="Ngày ký nhận" Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" />
                    <DatePicker x:Name="DpNgayKyNhan" Grid.Row="1" Grid.Column="4" />
                </Grid>

                <TextBlock Text="(10) Ghi chú" Style="{StaticResource Label}" Margin="0,12,0,2" />
                <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="1000" VerticalContentAlignment="Top" />
                <TextBlock x:Name="TxtMeta" Style="{StaticResource Hint}" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
