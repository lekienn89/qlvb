<Window x:Class="Qlvb.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý văn bản đi – đến" Width="1360" Height="840" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="/Assets/qlvb.ico">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static ApplicationCommands.Print}" />
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{x:Static NavigationCommands.BrowseStop}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="CmdNew" />
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="CmdFind" />
        <CommandBinding Command="{x:Static ApplicationCommands.Print}" Executed="CmdPrint" />
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="CmdRefresh" />
        <CommandBinding Command="{x:Static NavigationCommands.BrowseStop}" Executed="CmdLock" />
    </Window.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <DockPanel Background="{StaticResource Primary}" Grid.RowSpan="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,18">
                <Image Source="/Assets/qlvb.png" Width="36" Height="36" />
                <TextBlock Text="QUẢN LÝ&#x0a;VĂN BẢN ĐI – ĐẾN" Foreground="White" FontWeight="Bold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                <Button Content="🔒  Khóa màn hình (Ctrl+L)" Click="BtnLock_Click" Margin="12,2" HorizontalContentAlignment="Left" />
                <Button Content="⎋  Đăng xuất" Click="BtnLogout_Click" Margin="12,2" HorizontalContentAlignment="Left" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="home" Checked="Nav_Checked" Content="Trang chủ" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="di" Checked="Nav_Checked" Content="Văn bản đi" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="den" Checked="Nav_Checked" Content="Văn bản đến" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="tracuu" Checked="Nav_Checked" Content="Tra cứu" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="baocao" Checked="Nav_Checked" Content="Báo cáo – Thống kê" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="danhmuc" Checked="Nav_Checked" Content="Danh mục" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="saoluu" Checked="Nav_Checked" Content="Sao lưu / Khôi phục" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="nhatky" Checked="Nav_Checked" Content="Nhật ký" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="cauhinh" Checked="Nav_Checked" Content="Cấu hình" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="trogiup" Checked="Nav_Checked" Content="Trợ giúp" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Nội dung -->
        <DockPanel Grid.Column="1" Background="{StaticResource Surface}">
            <Border x:Name="SampleBanner" DockPanel.Dock="Top" Background="{StaticResource WarnBg}" Padding="12,6" Visibility="Collapsed">
                <DockPanel>
                    <Button Content="Xóa dữ liệu mẫu" DockPanel.Dock="Right" Click="BtnDeleteSample_Click" Margin="0" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Warn}" FontWeight="SemiBold"
                               Text="Đang có DỮ LIỆU MẪU (dữ liệu giả để làm quen). Xóa dữ liệu mẫu trước khi nhập văn bản thật." />
                </DockPanel>
            </Border>
            <ContentControl x:Name="Host" Margin="20,16,20,8" Focusable="False" />
        </DockPanel>

        <!-- Thanh trạng thái -->
        <Border Grid.Row="1" Grid.Column="1" Background="#EEF1F6" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="TxtStatusRight" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" />
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource Muted}" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
